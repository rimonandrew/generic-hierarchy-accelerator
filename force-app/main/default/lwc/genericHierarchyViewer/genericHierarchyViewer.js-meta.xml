<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Generic Hierarchy Viewer</masterLabel>
    <description>Metadata-driven hierarchy viewer for configured Salesforce objects.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property
                name="configurationName"
                type="String"
                label="Hierarchy Configuration Developer Name"
                default="Account_Hierarchy"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>